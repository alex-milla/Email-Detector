# ============================================================
#  Email Malware Detector — Configuración
#  Copia este archivo a config/.env y rellena los valores
# ============================================================

# --- Aplicación ---
SECRET_KEY=cambia_esto_por_un_valor_aleatorio
WEB_PORT=5000
# Duracion de la sesion en horas (por defecto 8)
# SESSION_LIFETIME_HOURS=8
# Contenedor / dev sin root: permite ejecutar install_dataset.sh / retrain.sh sin exigir uid 0 en el .sh
# En producción Linux instalada con install.sh como root, dejar sin definir o en false
# EMAIL_DETECTOR_RELAX_SCRIPT_CHECK=true

# --- Conexión IMAP genérica (Gmail App Password, Outlook...) ---
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Gmail OAuth2 (alternativa al App Password) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Microsoft 365 / Azure AD ---
# Requiere registro en https://portal.azure.com
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_EMAIL=

# --- VirusTotal API ---
VIRUSTOTAL_API_KEY=

# --- Modelos ML ---
# GPU: true activa GPU en el modelo Anti-Clanker si hay CUDA disponible
USE_GPU=false
# Modelos desactivados (separados por coma, ej: "model_3,model_7")
DISABLED_MODELS=

# --- Anti-Clanker (Modelo 10) ---
# URL pública para auto-actualización de reglas (dejar vacío para desactivar)
CLANKER_RULES_URL=
CLANKER_AUTO_UPDATE=false
# Peso del modelo Clanker en el ensemble (0.0 - 1.0)
CLANKER_MODEL_WEIGHT=0.1
# Idiomas habituales en contenido oculto (códigos separados por coma; 97 idiomas
# identificables con langid: es,en,fr,de,pt,it,ca,ko,ja,zh,ru,ar,hi...).
# Se configura desde la GUI (Configuracion -> Deteccion). El texto oculto en
# otros idiomas sube la sospecha (no fuerza MALICIOSO).
HIDDEN_TEXT_LANGS=es,en

# --- External Dynamic Lists (EDL) ---
# Listas externas de URLs, dominios e IPs maliciosas (se gestionan en la GUI).
# Interruptor global de detección EDL (true/false).
# EDL_ENABLED=true
# Tamaño máximo por lista descargada, en MB.
# EDL_MAX_FILE_MB=50
# Nº máximo de indicadores admitidos por lista.
# EDL_MAX_ENTRIES=1000000
# Analizar las IPs de las cabeceras Received contra las listas de IPs.
# EDL_CHECK_RECEIVED_IPS=true
# Omitir la consulta a VirusTotal si ya hay coincidencia en una EDL (ahorra cuota).
# EDL_SKIP_VT_ON_MATCH=false

# --- Autenticación de correo (SPF/DKIM/DMARC) ---
# Multiplicador de la penalización de riesgo por fallos de autenticación.
# 0.0 desactiva la penalización (solo avisos), 1.0 es el valor por defecto.
# AUTH_RISK_WEIGHT=1.0

# --- HTTPS (solo si se usa certificado propio) ---
# SSL_CERT=/ruta/a/fullchain.pem
# SSL_KEY=/ruta/a/privkey.pem
